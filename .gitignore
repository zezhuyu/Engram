# ---------------------------------------------------------------------------
# verification/: keep the inputs the scripts read and the hand-written protocol
# documents; everything produced by a run, and every phase/milestone/task note,
# is regenerated locally and stays out of the repository.
# ---------------------------------------------------------------------------
/verification/*
!/verification/README.md
!/verification/release-matrix.json
!/verification/v1-gates.json
!/verification/live-backends/
!/verification/profile/
/verification/profile/*
!/verification/profile/labeled-corpus.json
!/verification/dream/
/verification/dream/*
!/verification/dream/labeled-scenarios.json
!/verification/acid/
/verification/acid/*
!/verification/acid/journal-protocol.md
!/verification/acid/fault-points.json
!/verification/durability/
/verification/durability/*
!/verification/durability/commit-protocol.md
!/verification/durability/fault-points.json
!/verification/durability/vm/
/verification/durability/vm/*
!/verification/durability/vm/README.md
!/verification/durability/vm/agent.mjs
!/verification/durability/vm/fsync-eio.c
!/verification/durability/vm/run-kernel-fsync-eio.sh
!/verification/durability/vm/run-powercuts.sh
!/verification/benchmarks/
/verification/benchmarks/*
!/verification/benchmarks/methodology.md
!/verification/benchmarks/corpus-manifest.json

