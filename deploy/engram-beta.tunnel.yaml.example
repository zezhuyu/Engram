# Review template only: not installed, loaded or activated.
# Derived from the installed official sample_mcp_with_dcr profile (config v1).
# Generated by the dashboard for the private keyed-gateway flow.
# Secrets are read from the named environment variables; never paste values here.
config_version: 1
control_plane:
  base_url: "https://api.openai.com"
  tunnel_id: "${ENGRAM_TUNNEL_ID}"
  api_key: "env:ENGRAM_TUNNEL_RUNTIME_KEY"
health:
  listen_addr: "127.0.0.1:0"
admin_ui:
  open_browser: false
log:
  level: info
  format: json
mcp:
  server_urls:
    - channel: main
      url: "http://127.0.0.1:3335/mcp"
