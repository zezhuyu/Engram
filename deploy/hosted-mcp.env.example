# Private HTTP service template. Fill identity/ACL placeholders before use.
# No public listener, certificate, tunnel activation or service installation implied.
# Protect the real environment file with chmod 600. No legacy shared token.
MDB_ROOT=/absolute/path/to/disposable-hosted-beta-vault
MDB_MCP_TRANSPORT=http
MDB_MCP_TOOLSET=remote-web
MDB_MCP_HTTP_HOST=127.0.0.1
MDB_MCP_HTTP_PORT=3333
MDB_MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:3333,localhost:3333
# PUBLIC_URL is deliberately unset for the private HTTP baseline.
MDB_MCP_HTTP_REQUESTS_PER_MINUTE=120
MDB_MCP_OAUTH_ISSUER=https://identity.example.com/
MDB_MCP_OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
MDB_MCP_OAUTH_RESOURCE=http://127.0.0.1:3333/mcp
MDB_MCP_OAUTH_AUDIENCE=http://127.0.0.1:3333/mcp
MDB_MCP_OAUTH_CLIENT_IDS='["chatgpt-client-id","claude-client-id"]'
MDB_MCP_OAUTH_SUBJECTS_JSON='{"immutable-user-subject":{"actorId":"web-permission-ceiling","permissions":["workspace:hosted-beta:read","workspace:hosted-beta:write"],"clients":{"chatgpt-client-id":{"actorId":"chatgpt-web-beta","permissions":["workspace:hosted-beta:read"]},"claude-client-id":{"actorId":"claude-web-beta","permissions":["workspace:hosted-beta:read","workspace:hosted-beta:write"]}}}}'
MDB_MCP_OAUTH_SCOPE_MAP_JSON='{"memory.read":["workspace:hosted-beta:read"],"memory.write":["workspace:hosted-beta:write"]}'
# This loopback resource/audience must match the issuer-issued tokens. Hosted
# OAuth resource identifiers/discovery must be checked through the approved adapter.
# Do not silently replace the resource or accept multiple arbitrary audiences.
# Tailscale is a separate opt-in mode; leave MDB_TRANSPORT_TRUST unset here.
