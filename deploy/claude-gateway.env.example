# OPTIONAL external HTTPS adapter overlay; not a local Engram prerequisite.
# Apply only after approval of the exact hostname, ingress and issuer registration.
# The underlying Engram process still listens on HTTP loopback.
MDB_MCP_HTTP_HOST=127.0.0.1
MDB_MCP_HTTP_PORT=3333
MDB_MCP_PUBLIC_URL=https://memory.example.com
MDB_MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:3333,localhost:3333,memory.example.com
MDB_MCP_OAUTH_RESOURCE=https://memory.example.com/mcp
MDB_MCP_OAUTH_AUDIENCE=https://memory.example.com/mcp
# Preserve the issuer/JWKS, allowlisted clients, per-client grants and scope map.
# Coordinate audience changes with the issuer and the ChatGPT tunnel integration;
# the service currently has one configured resource/audience. Never disable checks.
# Leave MDB_TRANSPORT_TRUST unset; this is not the Tailscale profile.
