# Linux verification image: GNU coreutils/grep/diffutils/sed/gawk, jq and ripgrep, Node 22.
# Build context is the repository (see .dockerignore); dependencies are installed from the lockfile.
FROM node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends gawk jq ripgrep && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV MDB_REQUIRE_GNU=1 CI=1
RUN npm run build
